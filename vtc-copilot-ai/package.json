{
  "name": "vtc-copilot-ai-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site officiel de VTC Copilot AI : landing page, démonstration et waitlist Île-de-France.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:unit": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:e2e",
    "preview": "wrangler dev --local --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply vtc-copilot-ai-waitlist --local",
    "db:migrate:remote": "wrangler d1 migrations apply vtc-copilot-ai-waitlist --remote",
    "deploy": "npm run build && wrangler d1 migrations apply vtc-copilot-ai-waitlist --remote && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  }
}
