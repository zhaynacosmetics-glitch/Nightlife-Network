# Copier en .dev.vars pour le développement local (wrangler dev), et définir les mêmes valeurs
# en production avec `npx wrangler secret put <NOM>`. Ne jamais commiter de vraie valeur.

# Clé d'accès aux exports /api/admin/* (24 caractères minimum). Exemple de génération : openssl rand -base64 32
ADMIN_TOKEN=

# Sel du hachage des adresses IP utilisé pour la limitation de débit. Exemple : openssl rand -hex 32
IP_HASH_SALT=

# Facultatif : clé secrète Cloudflare Turnstile (la clé publique va dans src/config/site.ts → turnstileSiteKey)
TURNSTILE_SECRET_KEY=

# Facultatif, au moment du build : URL publique du site, pour les balises canonical, Open Graph et le sitemap
SITE_URL=

# Uniquement pour déployer depuis la ligne de commande ou la CI (jamais dans le code)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
